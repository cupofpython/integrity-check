{
  "policies": [
    {
      "name": "chainguard-public",
      "oidc_issuer": "https://token.actions.githubusercontent.com",
      "certificate_identity": "https://github.com/chainguard-images/images/.github/workflows/release.yaml@refs/heads/main"
    },
    {
      "name": "chainguard-private",
      "oidc_issuer": "https://issuer.enforce.dev",
      "certificate_identity_regexp": "^https://issuer\\.enforce\\.dev/(YOUR_CATALOG_SYNCER|YOUR_APKO_BUILDER)$"
    },
    {
      "name": "dockerhub-verified-publisher",
      "oidc_issuer": "https://token.actions.githubusercontent.com",
      "certificate_identity": "https://github.com/docker-library/official-images/.github/workflows/sign.yaml@refs/heads/master"
    }
  ]
}